FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

WORKDIR /srv/app
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} \
    APP_PORT=8080 \
    APP_HEALTH_MODE=down \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY app.py settings.py ./
USER 10001:10001
EXPOSE 8080
CMD ["python", "app.py"]
